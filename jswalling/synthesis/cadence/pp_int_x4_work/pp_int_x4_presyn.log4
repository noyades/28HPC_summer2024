  flow_log_directory:    logs
  flow_log_prefix_generator:  
      # Work out the subset of steps we are running
      set startPath [split $start_step "."]
      set logPrefix $startPath
      set endPath [split $end_step "."]
      set logSuffix {}
      set suffixOffset 0
      for {set i 0} {$i < [llength $startPath]} {incr i} {
        if {[lindex $startPath $i] ne [lindex $endPath $i]} {
          if {$subflow_start_step && $subflow_end_step} {
            set logPrefix [lrange $startPath 0 [expr {$i - 1}]]
          } else {
            if {$type eq "db"} {
              # Don't include the start step for database names
              set logPrefix [lrange $startPath 0 [expr {$i - 1}]]
            } else {
              set logPrefix $startPath
            }
            if {$type eq "log" || !$subflow_end_step} {
              if {$i < [llength $endPath]} {
                set logSuffix [lrange $endPath $i end]
                set suffixOffset $i
              }
            }
          }
          break
        }
      }
      if {$logPrefix ne {}} {
        set offset 0
        # Exclude any -skip_metric flows/steps
        for {set i 0} {$i < [llength $logPrefix]} {incr i} {
          if {[get_db [lindex $start_step_cp [expr {(($i + $offset) * 2) + 1}]] .skip_metric]} {
            set logPrefix [lreplace $logPrefix $i $i]
            incr i -1
            incr offset
          }
        }
        set logPrefix [join $logPrefix "."]
      }
      if {$logSuffix ne {}} {
        set offset $suffixOffset
        # Exclude any -skip_metric flows/steps
        for {set i 0} {$i < [llength $logSuffix]} {incr i} {
          if {[get_db [lindex $end_step_cp [expr {(($i + $offset) * 2) + 1}]] .skip_metric]} {
            set logSuffix [lreplace $logSuffix $i $i]
            incr i -1
            incr offset
          }
        }
        set logSuffix [join $logSuffix "."]
        if {$logPrefix ne {}} {
          if {$type eq "db"} {
            append logPrefix "."
          } else {
            append logPrefix "-"
          }
        }
        append logPrefix $logSuffix
      }
      # Add the branch name
      if {$branch ne {}} {
        if {$logPrefix eq {}} {
          set logPrefix $branch
        } else {
          set logPrefix "$branch.$logPrefix"
        }
      }
      # Add the top-level flow to the prefix
      if {![get_db $flow .skip_metric]} {
        if {$logPrefix eq {}} {
          set logPrefix [string range $flow 5 end]
        } else {
          set logPrefix "[string range $flow 5 end].$logPrefix"
        }
      }
      # Add the child-of prefix
      if {$child_of ne {}} {
        set childPrefix {}
        foreach cp $child_of {
          if {[string range $cp 0 4] eq "flow:" && ![get_db $cp .skip_metric]} {
            lappend childPrefix [string range $cp 5 end]
          }
        }
        if {$childPrefix ne {}} {
          set logPrefix "[join $childPrefix "."].$logPrefix"
        }
      }
      # Fall back to tool name
      if {$logPrefix eq {}} {
        set logPrefix $tool
      }
      # Add the flow log directory
      set logPrefix [file join $flow_log_directory $logPrefix]
      return $logPrefix
    
