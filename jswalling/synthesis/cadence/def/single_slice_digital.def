- Discrete_FIR_Filter_1_out_im[2]
  ( PIN Discrete_FIR_Filter_1_out_im[2] ) ;
- Discrete_FIR_Filter_1_out_im[1]
  ( PIN Discrete_FIR_Filter_1_out_im[1] ) ;
- clk
  ( PIN clk ) ;
- reset
  ( PIN reset ) ;
- enb
  ( PIN enb ) ;
END NETS

SPECIALNETS 2 ;
- VDD
  + USE POWER ;
- VSS
  + USE GROUND ;
END SPECIALNETS

END DESIGN
