M8.DN.6
3 3 20 Mar 03 14:21:43 2025
"Metal Density >= 0.01 must be followed for item(A) to (C)"
"(A) Metal density [checking window 80 um x 80 um, stepping 40 um] >= 0.01"
"(B) Maximum area of merged low density windows [checking window 10 um x 10 um, stepping 5 um, density < 0.01] <= 6400 um2. Merged low density windows width <= 30 um is except."
"(C) Maximum area of merged low density windows [checking window 10 um x 10 um, stepping 5 um, density < 0.01] <= 18000 um2"
"1. The following special regions are excluded"
"   Chip corner triangle empty areas if sealring is added by tsmc."
"   LOWMEDN"
"2. This rule is applied while the width of (checking window NOT above excluding region) >= 40 um for (A) and >= 5 um for both (B)/(C)"
 DENSITY M8.DN.6:M8_CHECK M1.DN.6:CHIP_CHECK -lt 0.010000 -window 80.000000 80.000000 -step 40.000000 40.000000 -inside_of layer CHIP_M1 -backup M8.DN.6:ERR_WIN_A
 NOT M8.DN.6:ERR_WIN_A NEW_DEN_EXC M8.DN.6:_EPTMPL273325
 WITH_WIDTH M8.DN.6:_EPTMPL273325 -ge 40.000000 M8.DN.6:F_A
 DENSITY M8.DN.6:F_A M8.DN.6:M8_CHECK M1.DN.6:CHIP_CHECK -lt 0.010000 -window 80.000000 80.000000 -step 40.000000 40.000000 -inside_of layer CHIP_M1 -backup -print M8.DN.6_A.density M8.DN.6:L273327
 DENSITY M8.DN.6:M8_CHECK M1.DN.6:CHIP_CHECK -lt 0.010000 -window 10.000000 10.000000 -step 5.000000 5.000000 -inside_of layer CHIP_M1 -backup M8.DN.6:ERR_WIN_B
 NOT M8.DN.6:ERR_WIN_B NEW_DEN_EXC M8.DN.6:_EPTMPL273329
 WITH_WIDTH M8.DN.6:_EPTMPL273329 -ge 5.000000 M8.DN.6:F_B
 DENSITY M8.DN.6:F_B M8.DN.6:M8_CHECK M1.DN.6:CHIP_CHECK -lt 0.010000 -window 10.000000 10.000000 -step 5.000000 5.000000 -inside_of layer CHIP_M1 -backup -print M8.DN.6_BC.density M8.DN.6:A
 AREA M8.DN.6:A -gt 6400.000000 M8.DN.6:B
 SIZE M8.DN.6:B -by 15.000000 -underover M8.DN.6:C
 SELECT -interact M8.DN.6:B M8.DN.6:C M8.DN.6:L273334
