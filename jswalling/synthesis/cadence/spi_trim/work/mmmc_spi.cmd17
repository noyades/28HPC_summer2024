# OS:   CentOS Linux release 7.9.2009 (Core)

source ../scripts/run.tcl
# entering suspend mode
resume
# resuming normal operation
get_dont_use
get dont_use
[get_lib_cells */*FSDPQ_*]
list dont_use
set_dont_use [get_lib_cells */*FD*]
set_dont_use [get_lib_cells */*FSD*]
echo ${dont_use}
set dont_use_list_6p75t [list *_0P* *_16 *_16P5 *_17 *_18 *_20 *_24 *_32 *_33 *_65 *_DEL* *_TIE* *ECO* *CLAMP* *DICE*]
remove_attribute [get_lib_cells */*FSDPSBQ_*_4] dont_use ;
set dont_use_list_6p75t [list *_0P* *_16 *_16P5 *_17 *_18 *_20 *_24 *_32 *_33 *_65 *_DEL* *_TIE* *ECO* *CLAMP* *DICE*]
foreach dont_use ${dont_use_list_#} {
        echo "[get_attribute [get_lib_cells */${dont_use}] full_name]"
               set_dont_use [get_lib_cells */${dont_use} ]}
foreach dont_use ${avoid_list_#} {
        echo "[get_attribute [get_lib_cells */${dont_use}] full_name]"
               set_dont_use [get_lib_cells */${dont_use} ]}
set_attribute avoid false [get_lib_cells */*_FSDPQ_*]
set_db avoid false [get_lib_cells */*_FSDPQ_*]
set_db [get_lib_cells */*_FSDPQ_*] .avoid false
get_db [get_lib_cells */*FD*] .avoid
get_db [get_lib_cells */*FSD*] .avoid
set_dont_use [list *_0P* *_16 *_16P5 *_17 *_18 *_20 *_24 *_32 *_33 *_65 *_DEL* *_TIE* *ECO* *CLAMP* *DICE*]
get_db [get_lib_cells *DICE*] .avoid
get_db [get_lib_cells *CLAMP*] .avoid
exit
