    index_2 ("1000.0, 1001.0, 1002.0, 1003.0, 1004.0, 1005.0, 1006.0");
  }
  lu_table_template(hold_template_7x7) {
    variable_1 : constrained_pin_transition;
    variable_2 : related_pin_transition;
