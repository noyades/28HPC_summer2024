read_db INVS/
source ../scripts/init.tcl 
report_timing
opt_design -pre_cts 
report_timing
opt_design -pre_cts 
source ../scripts/cts.tcl 
report_timing
source ../scripts/postcts.tcl 
report_timing
report_timing -view func-typ-typ
report_timing -view typ-typ-func
source ../scripts/route.tcl 
report_timing -view typ-typ-func
report_timing -view func-typ-typ
source ../scripts/postroute.tcl 
set_layer_preference violation -is_visible 1
route_eco -fix_drc 
eval_legacy { violationBrowserDelete -tool NanoRoute }
check_drc 
set_layer_preference violation -is_visible 1
delete_routes -regular_wire_with_drc 
eval_legacy { violationBrowserDelete -tool NanoRoute }
eval_legacy { violationBrowserDelete -tool Verify }
route_design
report_timing -view func-typ-typ
set_layer_preference violation -is_visible 1
route_eco -fix_drc 
route_eco -fix_drc 
set_layer_preference violation -is_visible 1
report_timing -view func-typ-typ
write_db ${top_cell}_inn.enc
write_stream ${top_cell}_struct_inn.gds -map_file /data/PDK/tsmc/28nm/stdcells/arm/tsmc/cln28ht/arm_tech/r1p0/lef/1p9m_6x2z_utalrdl/tech.map
write_netlist ${top_cell}_struct_inn.v
exit
