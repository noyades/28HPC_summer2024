gui_select -point {738.89350 622.01400}
source ../scripts/init.tcl 
report_timing
opt_design -pre_cts 
report_timing
opt_design -pre_cts 
report_timing
source ../scripts/cts.tcl 
report_timing
source ../scripts/postcts.tcl 
report_timing
source ../scripts/route.tcl 
report_timing
source ../scripts/postroute.tcl 
ereport_timing
report_timing
opt_design -post_route -incremental 
report_timing
opt_design -post_route -incremental 
report_timing
set_layer_preference violation -is_visible 1
route_eco -fix_drc -trim_layer_patch 
