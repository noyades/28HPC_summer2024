VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;

DESIGN bin2thermo ;

UNITS DISTANCE MICRONS 1000 ;
PROPERTYDEFINITIONS
  DESIGN CatenaDesignType STRING "asic" ;
END PROPERTYDEFINITIONS

DIEAREA ( 68230 -2945 ) ( 99330 50855 ) ;

PINS 11 ;
- IN[0] + NET IN[0]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 220 220 )
    + PLACED ( 84240 -2745 ) N ;
- IN[2] + NET IN[2]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 220 220 )
    + PLACED ( 82240 -2745 ) N ;
- IN[1] + NET IN[1]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 220 220 )
    + PLACED ( 83240 -2745 ) N ;
- BGREN[0] + NET BGREN[0]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 120 120 )
    + PLACED ( 68285 34755 ) N ;
- BGREN[7] + NET BGREN[7]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 120 120 )
    + PLACED ( 68285 45255 ) N ;
- BGREN[6] + NET BGREN[6]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 120 120 )
    + PLACED ( 68285 43755 ) N ;
- BGREN[5] + NET BGREN[5]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 120 120 )
    + PLACED ( 68285 42255 ) N ;
- BGREN[4] + NET BGREN[4]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 120 120 )
    + PLACED ( 68285 40755 ) N ;
- BGREN[3] + NET BGREN[3]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 120 120 )
    + PLACED ( 68285 39255 ) N ;
- BGREN[2] + NET BGREN[2]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 120 120 )
    + PLACED ( 68285 37755 ) N ;
- BGREN[1] + NET BGREN[1]
  + DIRECTION INOUT
  + PORT
    + LAYER M4 ( 0 0 ) ( 120 120 )
    + PLACED ( 68285 36255 ) N ;
END PINS

BLOCKAGES 7 ;
- LAYER RV
  RECT ( 69230 -1945 ) ( 98330 49855 ) ;
- LAYER M8
  RECT ( 69230 -1945 ) ( 98330 49855 ) ;
- LAYER VIA8
  RECT ( 69230 -1945 ) ( 98330 49855 ) ;
- LAYER M9
  RECT ( 69230 -1945 ) ( 98330 49855 ) ;
- LAYER VIA9
  RECT ( 69230 -1945 ) ( 98330 49855 ) ;
- LAYER M10
  RECT ( 69230 -1945 ) ( 98330 49855 ) ;
- LAYER AP
  RECT ( 69230 -1945 ) ( 98330 49855 ) ;
END BLOCKAGES

NETS 11 ;
- IN[0]
  ( PIN IN[0] ) ;
- IN[2]
  ( PIN IN[2] ) ;
- IN[1]
  ( PIN IN[1] ) ;
- BGREN[0]
  ( PIN BGREN[0] ) ;
- BGREN[7]
  ( PIN BGREN[7] ) ;
- BGREN[6]
  ( PIN BGREN[6] ) ;
- BGREN[5]
  ( PIN BGREN[5] ) ;
- BGREN[4]
  ( PIN BGREN[4] ) ;
- BGREN[3]
  ( PIN BGREN[3] ) ;
- BGREN[2]
  ( PIN BGREN[2] ) ;
- BGREN[1]
  ( PIN BGREN[1] ) ;
END NETS

END DESIGN
