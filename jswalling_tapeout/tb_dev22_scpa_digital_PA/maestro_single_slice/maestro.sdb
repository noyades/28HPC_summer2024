		<tests>
			<test enabled="1">dev28_behdad_tb_dev22_scpa_digital_PA_1
				<tool>ADE</tool>
				<tooloptions>
					<option>cell
						<value>tb_dev22_scpa_digital_PA</value>
					</option>
					<option>lib
						<value>dev28_behdad</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic_signle_slice</value>
					</option>
					<option>path
						<value>$AXL_SETUPDB_DIR</value>
					</option>
					<option>state
						<value>active</value>
					</option>
				</tooloptions>
				<vars>
					<var>t_stop
						<value>80*T</value>
					</var>
					<var>res
						<value>2**N - 1</value>
					</var>
					<var>T
						<value>1/frq</value>
					</var>
					<var>vdd
						<value>0.9</value>
					</var>
					<var>N
						<value>8</value>
					</var>
					<var>frq
						<value>12.8G</value>
					</var>
					<var>L
						<value>444.4p</value>
					</var>
					<var>R1
						<value>8*19.12</value>
					</var>
					<var>t_start
						<value>0</value>
					</var>
					<var>code_I
						<value>0</value>
					</var>
					<var>code_Q
						<value>128</value>
					</var>
				</vars>
				<origoptions>
					<option>cell
						<value>tb_dev22_scpa_digital_PA</value>
					</option>
					<option>lib
						<value>dev28_behdad</value>
					</option>
					<option>sim
						<value>spectre</value>
					</option>
					<option>view
						<value>schematic</value>
					</option>
				</origoptions>
				<outputs>
					<output>tstart
						<evalType>point</evalType>
					</output>
					<output>tend
						<evalType>point</evalType>
					</output>
					<output>dft((vtime('tran "/VOP") - vtime('tran "/VON")) (122 * VAR("T")) (142 * VAR("T")) 511 "Blackman" 1 1 1.0)
						<evalType>point</evalType>
					</output>
					<output>dft_amplitude
						<evalType>point</evalType>
					</output>
					<output>dft_angle_unwrapped
						<evalType>point</evalType>
					</output>
					<output>dft_angle
						<evalType>point</evalType>
					</output>
					<output>c
						<evalType>point</evalType>
					</output>
					<output>dB20(abs(dft((vtime('tran "/VOP") - vtime('tran "/VON")) (122 * VAR("T")) (142 * VAR("T")) 63 "BlackmanHarris" 1 "default" 1)))
						<evalType>point</evalType>
					</output>
					<output>dft((vtime('tran "/VOP") - vtime('tran "/VON")) tstart tend 63 "BlackmanHarris" 1 "default" 1)
						<evalType>point</evalType>
					</output>
					<output>dft((vtime('tran "/VOP") - vtime('tran "/VON")) (122 * VAR("T")) (142 * VAR("T")) 63 "BlackmanHarris" 1 "default" 1)
						<evalType>point</evalType>
					</output>
					<output>dft((vtime('tran "/VOP") - vtime('tran "/VON")) (283 * VAR("T")) (291 * VAR("T")) 127 "BlackmanHarris" 1 "default" 1)
						<evalType>point</evalType>
					</output>
					<output>dft((vtime('tran "/VOP") - vtime('tran "/VON")) (283 * VAR("T")) (291 * VAR("T")) 31 "BlackmanHarris" 1 "default" 1)
						<evalType>point</evalType>
					</output>
					<output>dft((vtime('tran "/VOP") - vtime('tran "/VON")) (283 * VAR("T")) (291 * VAR("T")) 32 "BlackmanHarris" 1 "default" 1)
						<evalType>point</evalType>
					</output>
					<output>Ropt
						<evalType>point</evalType>
					</output>
					<output>Pout_lin
						<evalType>point</evalType>
					</output>
					<output>pout_dbm2
						<evalType>point</evalType>
					</output>
					<output>LSB
						<evalType>point</evalType>
					</output>
					<output>I
						<evalType>point</evalType>
					</output>
					<output>Q
						<evalType>point</evalType>
					</output>
					<output>Amp
						<evalType>point</evalType>
					</output>
					<output>diff
						<evalType>point</evalType>
					</output>
					<output>20_cycle_clip
						<evalType>point</evalType>
					</output>
					<output>Vswing
						<evalType>point</evalType>
					</output>
					<output>dft(Vout_diff 9.087926e-10 6.25e-09 2048 "BlackmanHarris" 0 0 1)
						<evalType>point</evalType>
					</output>
					<output>(Vswing / (2 * LSB))
						<evalType>point</evalType>
					</output>
					<output>(Vswing / (4 * LSB))
						<evalType>point</evalType>
					</output>
					<output>magnitude
						<evalType>point</evalType>
					</output>
				</outputs>
			</test>
		</tests>
